{
  "expo": {
    "name": "ULVA",
    "slug": "gestao-de-loja",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.lucasalberto.gestaodeloja",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundColor": "#46FCDF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lucasalberto.gestaodeloja",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "NSMotionUsageDescription": "Usamos o contador de passos do celular pra registrar quantos passos foram dados durante o Checklist de Setor.",
        "NSLocationWhenInUseUsageDescription": "Usamos a localização pra registrar onde o Checklist de Setor foi feito."
      }
    },
    "web": {
      "favicon": "./assets/icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "b3d3f1f8-eca6-4446-baec-3ae7046db643"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Precisamos da câmera pra ler o código de barras dos produtos na tela de Validade."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B2A6B"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Precisamos acessar suas fotos pra anexar uma imagem no Mural de Avisos.",
          "cameraPermission": "Precisamos da câmera pra tirar uma foto pro Mural de Avisos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos a localização pra registrar onde o Checklist de Setor foi feito."
        }
      ],
      "expo-video"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b3d3f1f8-eca6-4446-baec-3ae7046db643"
    }
  }
}
